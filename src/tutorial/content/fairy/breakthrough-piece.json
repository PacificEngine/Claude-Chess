          "hint": "It takes diagonally forward, not straight ahead."
        },
        {
          "prompt": "Win the black pawn in two moves.",
          "board": { "setup": { "base": "chess", "files": 8, "ranks": 8, "pieces": { "k": "king", "p": "pawn", "n": "knight", "e": "breakthrough" }, "fen": "8/8/1K6/1p6/k7/8/1E6/8 w - - 0 1", "castling": false, "promotion": { "rank": "last", "pieceTypes": ["n"] } } },
          "goal": { "kind": "capture", "square": "b5" },
          "moves": 2,
          "line": ["b2c3", "b5b4", "c3b4"],
