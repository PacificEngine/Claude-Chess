          "goal": { "kind": "mate" },
          "moves": 1,
          "line": ["f1g1"],
          "hint": "Check the king from right beside it, where your king guards the gold."
        },
        {
          "prompt": "Checkmate in two moves.",
          "board": { "setup": { "base": "chess", "files": 8, "ranks": 8, "pieces": { "k": "king", "p": "pawn", "n": "knight", "g": "gold" }, "fen": "8/8/8/8/8/8/k1K5/2G5 w - - 0 1", "castling": false, "promotion": { "rank": "last", "pieceTypes": ["n"] } } },
          "goal": { "kind": "mate" },
          "moves": 2,
