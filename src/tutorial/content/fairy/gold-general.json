          "hint": "The gold can take diagonally forward."
        },
        {
          "prompt": "Win the black pawn in two moves.",
          "board": { "setup": { "base": "chess", "files": 8, "ranks": 8, "pieces": { "k": "king", "p": "pawn", "n": "knight", "g": "gold" }, "fen": "8/8/8/8/8/6K1/4G1p1/6k1 w - - 0 1", "castling": false, "promotion": { "rank": "last", "pieceTypes": ["n"] } } },
          "goal": { "kind": "capture", "square": "g2" },
          "moves": 2,
          "line": ["e2f2", "g1h1", "f2g2"],
